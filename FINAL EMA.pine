//@version=6
indicator("DeltaBot 100x | Option A: Strict 21 EMA Body Cut Breakout (15m)", overlay=true, max_lines_count=500, max_boxes_count=100)

// ============================================================================
// INPUTS & WEBHOOK SETTINGS
// ============================================================================

webhookPassphrase = input.string("supersecretpassphrase123", "Webhook Passphrase (match .env)", group="BOT AUTOMATION")
orderSize = input.int(1, "Order Size (Contracts)", minval=1, group="BOT AUTOMATION")

// ---------------- OPTION A: 21 EMA BODY CUT SETTINGS ----------------
emaLength = input.int(21, "Entry 21 EMA Length", minval=1, group="ENTRY (OPTION A)")
enableLiveIntraBar = input.bool(true, "Execute Instantly on Breakout (No close delay)", group="ENTRY (OPTION A)")
enableTrendContinuation = input.bool(false, "Enable Trend Continuation Re-entries (Disabled for Option A)", group="ENTRY (OPTION A)")

// ---------------- EXIT & CONFIRMATIONS ----------------
enableSmartExit = input.bool(true, "Enable Smart Exit", group="EXIT & CONFIRMATIONS")
exitOnOpposite = input.bool(true, "Exit On Opposite Signal", group="EXIT & CONFIRMATIONS")
exitConfirmations = input.int(3, "Required Exit Confirmations (out of 4, with 21 EMA Violation)", minval=1, maxval=4, group="EXIT & CONFIRMATIONS")

exitEMALength = input.int(21, "Exit EMA Length", minval=1, group="EXIT INDICATORS")
rsiLength = input.int(14, "RSI Length", minval=1, group="EXIT INDICATORS")
atrLength = input.int(14, "ATR Length", minval=1, group="EXIT INDICATORS")

// ---------------- ZERO-LOSS & PROFIT PROTECTION ----------------
enableBreakeven = input.bool(true, "Enable Zero-Loss Auto-Breakeven", group="PROTECTION")
breakevenATR = input.float(0.85, "Breakeven Trigger ATR", minval=0.1, step=0.05, group="PROTECTION")
feeBufferUSD = input.float(1.50, "Fee Buffer in USD", minval=0.1, step=0.1, group="PROTECTION")

enableProtection = input.bool(true, "Enable Profit Protection (Dynamic Trailing)", group="PROTECTION")
activationATR = input.float(1.0, "Trailing Activation ATR", minval=0.1, step=0.05, group="PROTECTION")
trailATR = input.float(0.85, "Trailing Distance ATR", minval=0.1, step=0.05, group="PROTECTION")

enableEmergency = input.bool(true, "Enable Emergency Loss Exit", group="RISK & ANTI-LIQUIDATION")
emergencyATR = input.float(1.50, "Emergency Loss ATR", minval=0.1, step=0.05, group="RISK & ANTI-LIQUIDATION")

// ---------------- NEW: SMART ENTRY FILTERS ----------------
enableVolumeFilter = input.bool(true, "Enable Volume Filter (Reject Low-Volume Breakouts)", group="SMART FILTERS")
volumeMultiplier = input.float(1.5, "Volume Multiplier (×Avg)", minval=0.5, step=0.1, group="SMART FILTERS")
volumeLookback = input.int(20, "Volume Lookback Bars", minval=5, group="SMART FILTERS")

enableADXFilter = input.bool(true, "Enable ADX Filter (Skip Choppy Markets)", group="SMART FILTERS")
adxLength = input.int(14, "ADX Length", minval=5, group="SMART FILTERS")
minADX = input.float(20.0, "Min ADX for Entry", minval=5.0, step=1.0, group="SMART FILTERS")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

entryEMA = ta.ema(close, emaLength)
exitEMA = ta.ema(close, exitEMALength)
exitRSI = ta.rsi(close, rsiLength)
exitATR = ta.atr(atrLength)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

// ── NEW: ADX Calculation ──
dirmov(len) =>
    upMove = ta.change(high)
    downMove = -ta.change(low)
    plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
    trueRange = ta.rma(ta.tr, len)
    plusDI = 100 * ta.rma(plusDM, len) / trueRange
    minusDI = 100 * ta.rma(minusDM, len) / trueRange
    [plusDI, minusDI]

[plusDI, minusDI] = dirmov(adxLength)
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxValue = ta.rma(dx, adxLength)

// ── NEW: Volume Average ──
volAvg = ta.sma(volume, volumeLookback)
volConfirmed = volume > (volAvg * volumeMultiplier)

plot(entryEMA, title="21 EMA", color=color.rgb(6, 182, 212), linewidth=2)

// ============================================================================
// OPTION A: 21 EMA BODY CUT & DIRECTIONAL BREAKOUT LOGIC
// ============================================================================

// Strict Body Cut: 21 EMA must slice through the Candle Body (not just wicks)
bodyTop = math.max(open[1], close[1])
bodyBottom = math.min(open[1], close[1])
emaCuttingCandle = bodyBottom <= entryEMA[1] and bodyTop >= entryEMA[1]

bool rawBuy = false
bool rawSell = false

if emaCuttingCandle
    // Clean Directional Breakout: Must break structure, close on the correct side of EMA, and not violate opposite side
    bool cleanBreakHigh = high > high[1] and close > entryEMA and low >= low[1]
    bool cleanBreakLow = low < low[1] and close < entryEMA and high <= high[1]

    if cleanBreakHigh
        rawBuy := true
    else if cleanBreakLow
        rawSell := true
else if enableTrendContinuation
    bool uptrend = close > entryEMA and exitRSI >= 50 and macdLine >= macdSignal
    downtrend = close < entryEMA and exitRSI <= 50 and macdLine <= macdSignal
    if uptrend and high > high[1]
        rawBuy := true
    else if downtrend and low < low[1]
        rawSell := true

// ── NEW: Smart Filters — reject false breakouts ──
// Volume Filter: breakout candle must have above-average volume
if (rawBuy or rawSell) and enableVolumeFilter and not volConfirmed
    rawBuy := false
    rawSell := false

// ADX Filter: only trade in trending markets (ADX > minADX)
if (rawBuy or rawSell) and enableADXFilter and adxValue < minADX
    rawBuy := false
    rawSell := false
// ============================================================================
// POSITION STATE MACHINE (MASTER UNIFIED DEFENSE & EXIT)
// ============================================================================

var int positionState = 0
var float entryPrice = na
var float highestPrice = na
var float lowestPrice = na
var float activeStopLoss = na
var bool beLocked = false

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

// ---------------- LONG MANAGEMENT ----------------
if positionState == 1
    highestPrice := na(highestPrice) ? high : math.max(highestPrice, high)

    // Master Unified Confirmations: Requires closing below 21 EMA + 3 confirmations
    bool emaWeak = close < exitEMA
    bool rsiWeak = exitRSI < 50
    bool macdWeak = macdLine < macdSignal
    bool structureWeak = close < low[1]

    int longScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)
    bool smartExit = enableSmartExit and emaWeak and (longScore >= exitConfirmations)
    bool oppositeExit = exitOnOpposite and rawSell

    float profitATR = (close - entryPrice) / exitATR
    
    // 9% ROI Auto-Breakeven
    if enableBreakeven and profitATR >= breakevenATR
        float beLevel = entryPrice + feeBufferUSD
        if na(activeStopLoss) or activeStopLoss < beLevel
            activeStopLoss := beLevel
            beLocked := true

    // Dynamic Trailing Stop
    bool protectionActive = enableProtection and profitATR >= activationATR
    float candidateStop = math.max(entryPrice + (beLocked ? feeBufferUSD : 0), highestPrice - exitATR * trailATR)
    if protectionActive
        activeStopLoss := na(activeStopLoss) ? candidateStop : math.max(activeStopLoss, candidateStop)

    bool stopHit = not na(activeStopLoss) and close <= activeStopLoss
    bool emergencyHit = enableEmergency and profitATR <= -emergencyATR

    if smartExit or oppositeExit or stopHit or emergencyHit
        exitLong := true

// ---------------- SHORT MANAGEMENT ----------------
if positionState == -1
    lowestPrice := na(lowestPrice) ? low : math.min(lowestPrice, low)

    // Master Unified Confirmations: Requires closing above 21 EMA + 3 confirmations
    bool emaWeak = close > exitEMA
    bool rsiWeak = exitRSI > 50
    bool macdWeak = macdLine > macdSignal
    bool structureWeak = close > high[1]

    int shortScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)
    bool smartExit = enableSmartExit and emaWeak and (shortScore >= exitConfirmations)
    bool oppositeExit = exitOnOpposite and rawBuy

    float profitATR = (entryPrice - close) / exitATR
    
    // 9% ROI Auto-Breakeven
    if enableBreakeven and profitATR >= breakevenATR
        float beLevel = entryPrice - feeBufferUSD
        if na(activeStopLoss) or activeStopLoss > beLevel
            activeStopLoss := beLevel
            beLocked := true

    // Dynamic Trailing Stop
    bool protectionActive = enableProtection and profitATR >= activationATR
    float candidateStop = math.min(entryPrice - (beLocked ? feeBufferUSD : 0), lowestPrice + exitATR * trailATR)
    if protectionActive
        activeStopLoss := na(activeStopLoss) ? candidateStop : math.min(activeStopLoss, candidateStop)

    bool stopHit = not na(activeStopLoss) and close >= activeStopLoss
    bool emergencyHit = enableEmergency and profitATR <= -emergencyATR

    if smartExit or oppositeExit or stopHit or emergencyHit
        exitShort := true

// ---------------- EXITS ----------------
bool exitedThisBar = false

if exitLong
    positionState := 0
    entryPrice := na
    highestPrice := na
    lowestPrice := na
    activeStopLoss := na
    beLocked := false
    exitedThisBar := true

if exitShort
    positionState := 0
    entryPrice := na
    highestPrice := na
    lowestPrice := na
    activeStopLoss := na
    beLocked := false
    exitedThisBar := true

// ---------------- NEW ENTRIES ----------------
if positionState == 0 and not exitedThisBar
    if rawBuy
        newBuy := true
        positionState := 1
        entryPrice := close
        highestPrice := high
        lowestPrice := na
        activeStopLoss := low[1]  // First Stop Loss at LOW of Cut Candle
        beLocked := false
    else if rawSell
        newSell := true
        positionState := -1
        entryPrice := close
        lowestPrice := low
        highestPrice := na
        activeStopLoss := high[1]  // First Stop Loss at HIGH of Cut Candle
        beLocked := false

// ============================================================================
// VISUAL PLOTS ON CHART
// ============================================================================

plotshape(newBuy, title="BUY Entry", style=shape.labelup, location=location.belowbar, color=color.rgb(16, 185, 129), text="BUY (15m Body Cut)", textcolor=color.white, size=size.normal)
plotshape(newSell, title="SELL Entry", style=shape.labeldown, location=location.abovebar, color=color.rgb(244, 63, 94), text="SELL (15m Body Cut)", textcolor=color.white, size=size.normal)
plotshape(exitLong, title="EXIT LONG", style=shape.labeldown, location=location.abovebar, color=color.rgb(245, 158, 11), text="EXIT LONG", textcolor=color.white, size=size.small)
plotshape(exitShort, title="EXIT SHORT", style=shape.labelup, location=location.belowbar, color=color.rgb(245, 158, 11), text="EXIT SHORT", textcolor=color.white, size=size.small)

// Live Stop Loss / Trailing Line
plot(activeStopLoss, title="Active Stop-Loss / Trailing Level", color=color.rgb(239, 68, 68), linewidth=2, style=plot.style_linebr)

// Entry Price Reference Line
plot(positionState != 0 ? entryPrice : na, title="Entry Price", color=color.rgb(148, 163, 184), linewidth=1, style=plot.style_circles)

// ============================================================================
// HUD INFO TABLE (TOP RIGHT OF CHART)
// ============================================================================

var table hud = table.new(position.top_right, 2, 8, bgcolor=color.rgb(15, 23, 42, 20), border_color=color.rgb(255, 255, 255, 15), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Timeframe", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 0, "15m Smart Filters", text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 1, "Position", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string posStr = positionState == 1 ? "LONG 🟢" : (positionState == -1 ? "SHORT 🔴" : "FLAT ⚪")
    color posCol = positionState == 1 ? color.rgb(16, 185, 129) : (positionState == -1 ? color.rgb(244, 63, 94) : color.rgb(148, 163, 184))
    table.cell(hud, 1, 1, posStr, text_color=posCol, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 2, not na(entryPrice) ? "$" + str.tostring(entryPrice, "#.##") : "--", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "Active Stop", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 3, not na(activeStopLoss) ? "$" + str.tostring(activeStopLoss, "#.##") : "--", text_color=color.rgb(244, 63, 94), text_size=size.small)

    table.cell(hud, 0, 4, "Breakeven", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 4, beLocked ? "LOCKED (+Fees)" : "Ready (+9% ROI)", text_color=beLocked ? color.rgb(16, 185, 129) : color.rgb(245, 158, 11), text_size=size.small)

    table.cell(hud, 0, 5, "21 EMA / RSI", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 5, "$" + str.tostring(entryEMA, "#.##") + " / " + str.tostring(exitRSI, "#.#"), text_color=color.rgb(6, 182, 212), text_size=size.small)

    // ── NEW: ADX & Volume Filter Status ──
    string adxStr = str.tostring(adxValue, "#.#")
    string regimeStr = adxValue >= 25 ? "TRENDING ✅" : (adxValue < 20 ? "CHOPPY ❌" : "NEUTRAL ⚠️")
    color adxCol = adxValue >= 25 ? color.rgb(16, 185, 129) : (adxValue < 20 ? color.rgb(244, 63, 94) : color.rgb(245, 158, 11))
    table.cell(hud, 0, 6, "ADX / Regime", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 6, adxStr + " " + regimeStr, text_color=adxCol, text_size=size.small)

    string volStr = volConfirmed ? "HIGH VOL ✅" : "LOW VOL ❌"
    color volCol = volConfirmed ? color.rgb(16, 185, 129) : color.rgb(244, 63, 94)
    table.cell(hud, 0, 7, "Volume", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 7, volStr + " (" + str.tostring(volume, "#") + " / " + str.tostring(volAvg, "#") + ")", text_color=volCol, text_size=size.small)
// ============================================================================
// WEBHOOK ALERTS (EXCHANGE SYNCHRONIZED)
// ============================================================================

buyAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"BUY","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(low[1]) + '}'
sellAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"SELL","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(high[1]) + '}'
exitLongAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_LONG","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'
exitShortAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_SHORT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'

if newBuy
    alert(buyAlertMsg, alert.freq_once_per_bar)

if newSell
    alert(sellAlertMsg, alert.freq_once_per_bar)

if exitLong
    alert(exitLongAlertMsg, alert.freq_once_per_bar)

if exitShort
    alert(exitShortAlertMsg, alert.freq_once_per_bar)

// Alertcondition declarations for TradingView Alert Wizard
alertcondition(newBuy, title="DeltaBot BUY Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"BUY","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(newSell, title="DeltaBot SELL Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"SELL","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitLong, title="DeltaBot EXIT LONG Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_LONG","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitShort, title="DeltaBot EXIT SHORT Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_SHORT","symbol":"{{ticker}}","price":{{close}}}')
