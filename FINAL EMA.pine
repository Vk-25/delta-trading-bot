//@version=6
indicator("EMA Cut Breakout [Universal Smart Exit] - FIXED", overlay=true, max_lines_count=500)

// ============================================================================
// INPUTS
// ============================================================================

emaLength = input.int(21, "Entry EMA Length", minval=1, group="ENTRY")

showBarColors = input.bool(
     true,
     "Color Signal Candles",
     group="ENTRY")

showBreakoutLines = input.bool(
     true,
     "Show Breakout Lines",
     group="ENTRY")

// FIX #2: New input to stop signals from repainting on live/real markets.
// When true, all position/state changes only commit once the current bar
// is confirmed (closed). This is what makes the indicator behave the same
// live as it does in backtest/replay.
confirmOnBarClose = input.bool(
     true,
     "Confirm Signals On Bar Close (recommended for live/real markets)",
     group="ENTRY")

enableTrendContinuation = input.bool(
     true,
     "Enable Trend Continuation Re-entries",
     group="ENTRY")

// ---------------- EXIT ----------------

enableSmartExit = input.bool(
     true,
     "Enable Smart Exit",
     group="EXIT")

exitOnOpposite = input.bool(
     true,
     "Exit On Opposite Signal",
     group="EXIT")

exitConfirmations = input.int(
     2,
     "Required Exit Confirmations",
     minval=1,
     maxval=4,
     group="EXIT")

// ---------------- EXIT INDICATORS ----------------

exitEMALength = input.int(
     21,
     "Exit EMA Length",
     minval=1,
     group="EXIT INDICATORS")

rsiLength = input.int(
     14,
     "RSI Length",
     minval=1,
     group="EXIT INDICATORS")

atrLength = input.int(
     14,
     "ATR Length",
     minval=1,
     group="EXIT INDICATORS")

// ---------------- 100x ZERO-LOSS & PROFIT PROTECTION ----------------

enableBreakeven = input.bool(
     true,
     "Enable Zero-Loss Auto-Breakeven",
     group="PROTECTION")

breakevenATR = input.float(
     0.24,
     "Breakeven Activation ATR (0.24 = 9% ROI on 100x)",
     minval=0.1,
     step=0.01,
     group="PROTECTION")

enableProtection = input.bool(
     true,
     "Enable Profit Protection (Trailing ATR)",
     group="PROTECTION")

activationATR = input.float(
     0.50,
     "Trailing Activation ATR",
     minval=0.1,
     step=0.05,
     group="PROTECTION")

trailATR = input.float(
     0.35,
     "Trailing ATR Distance",
     minval=0.1,
     step=0.05,
     group="PROTECTION")

// ---------------- 100x EMERGENCY STOP (Anti-Liquidation) ----------------

enableEmergency = input.bool(
     true,
     "Enable Emergency Exit",
     group="RISK")

emergencyATR = input.float(
     0.45,
     "Emergency Loss ATR (Placed $10 before Liquidation)",
     minval=0.1,
     step=0.05,
     group="RISK")

// ============================================================================
// EMA & INDICATORS
// ============================================================================

entryEMA = ta.ema(close, emaLength)
exitEMA = ta.ema(close, exitEMALength)
exitRSI = ta.rsi(close, rsiLength)
exitATR = ta.atr(atrLength)
[macdLine, macdSignal, macdHistogram] = ta.macd(close, 12, 26, 9)

plot(
     entryEMA,
     title="Entry EMA",
     color=color.blue,
     linewidth=2)

// ============================================================================
// YOUR ORIGINAL ENTRY LOGIC
// ============================================================================

emaCuttingCandle =
     high[1] >= entryEMA[1] and
     low[1] <= entryEMA[1]

// ============================================================================
// RAW BUY / SELL
// ============================================================================

bool rawBuy = false
bool rawSell = false

if emaCuttingCandle

    bool breakHigh = high > high[1]
    bool breakLow = low < low[1]

    if breakHigh and breakLow

        if close > close[1]
            rawBuy := true

        else if close < close[1]
            rawSell := true

    else if breakHigh
        rawBuy := true

    else if breakLow
        rawSell := true

else if enableTrendContinuation
    bool uptrend = close > entryEMA and exitRSI >= 50 and macdLine >= macdSignal
    bool downtrend = close < entryEMA and exitRSI <= 50 and macdLine <= macdSignal

    if uptrend and (high > high[1] or (low[1] <= entryEMA and close > entryEMA))
        rawBuy := true
    else if downtrend and (low < low[1] or (high[1] >= entryEMA and close < entryEMA))
        rawSell := true

// ============================================================================
// POSITION STATE
// ============================================================================
//
//  0 = FLAT
//  1 = LONG
// -1 = SHORT
//
// ============================================================================

var int positionState = 0

var float entryPrice = na

var float highestPrice = na

var float lowestPrice = na

// Declared ratcheting trailing stops for profit protection
var float longTrailStop = na

var float shortTrailStop = na

// ============================================================================
// EXIT SIGNALS
// ============================================================================

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

// ============================================================================
// State execution gating for non-repainting live/real markets
// ============================================================================

bool canProcess = barstate.isconfirmed or not confirmOnBarClose

if canProcess

    // ========================================================================
    // LONG MANAGEMENT
    // ========================================================================

    if positionState == 1

        // Track highest price
        if na(highestPrice)
            highestPrice := high
        else
            highestPrice := math.max(highestPrice, high)

        // ----------------------------------------------------------------
        // Exit confirmations
        // ----------------------------------------------------------------

        bool emaWeak = close < exitEMA
        bool rsiWeak = exitRSI < 50
        bool macdWeak = macdLine < macdSignal
        bool structureWeak = close < low[1]

        int longScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)

        // ----------------------------------------------------------------
        // Smart exit
        // ----------------------------------------------------------------

        bool smartExit =
             enableSmartExit and
             longScore >= exitConfirmations

        // ----------------------------------------------------------------
        // Opposite signal
        // ----------------------------------------------------------------

        bool oppositeExit =
             exitOnOpposite and
             rawSell

        // ----------------------------------------------------------------
        // Profit protection
        // ----------------------------------------------------------------

        float longProfitATR =
             (close - entryPrice) / exitATR

        // Zero-Loss Auto-Breakeven
        if enableBreakeven and longProfitATR >= breakevenATR
            float beLevel = entryPrice + (exitATR * 0.05)
            if na(longTrailStop) or longTrailStop < beLevel
                longTrailStop := beLevel

        // Profit protection
        bool protectionActive =
             enableProtection and
             longProfitATR >= activationATR

        // Ratchet the trailing stop up so it never drops back down
        float longCandidateStop =
             math.max(
                 entryPrice,
                 highestPrice - exitATR * trailATR)

        if protectionActive
            if na(longTrailStop)
                longTrailStop := longCandidateStop
            else
                longTrailStop := math.max(longTrailStop, longCandidateStop)

        bool protectionExit =
             not na(longTrailStop) and
             close <= longTrailStop

        // ----------------------------------------------------------------
        // Emergency loss
        // ----------------------------------------------------------------

        bool emergencyExit =
             enableEmergency and
             longProfitATR <= -emergencyATR

        // ----------------------------------------------------------------
        // Final exit
        // ----------------------------------------------------------------

        if smartExit or oppositeExit or protectionExit or emergencyExit
            exitLong := true

    // ========================================================================
    // SHORT MANAGEMENT
    // ========================================================================

    if positionState == -1

        // Track lowest price
        if na(lowestPrice)
            lowestPrice := low
        else
            lowestPrice := math.min(lowestPrice, low)

        // ----------------------------------------------------------------
        // Exit confirmations
        // ----------------------------------------------------------------

        bool emaWeak = close > exitEMA
        bool rsiWeak = exitRSI > 50
        bool macdWeak = macdLine > macdSignal
        bool structureWeak = close > high[1]

        int shortScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)

        // ----------------------------------------------------------------
        // Smart exit
        // ----------------------------------------------------------------

        bool smartExit =
             enableSmartExit and
             shortScore >= exitConfirmations

        // ----------------------------------------------------------------
        // Opposite signal
        // ----------------------------------------------------------------

        bool oppositeExit =
             exitOnOpposite and
             rawBuy

        // ----------------------------------------------------------------
        // Zero-Loss Auto-Breakeven
        // ----------------------------------------------------------------

        float shortProfitATR =
             (entryPrice - close) / exitATR

        if enableBreakeven and shortProfitATR >= breakevenATR
            float beLevel = entryPrice - (exitATR * 0.05)
            if na(shortTrailStop) or shortTrailStop > beLevel
                shortTrailStop := beLevel

        // Profit protection
        bool protectionActive =
             enableProtection and
             shortProfitATR >= activationATR

        // Ratchet the trailing stop down so it never moves back up
        float shortCandidateStop =
             math.min(
                 entryPrice,
                 lowestPrice + exitATR * trailATR)

        if protectionActive
            if na(shortTrailStop)
                shortTrailStop := shortCandidateStop
            else
                shortTrailStop := math.min(shortTrailStop, shortCandidateStop)

        bool protectionExit =
             not na(shortTrailStop) and
             close >= shortTrailStop

        // ----------------------------------------------------------------
        // Emergency loss
        // ----------------------------------------------------------------

        bool emergencyExit =
             enableEmergency and
             shortProfitATR <= -emergencyATR

        // ----------------------------------------------------------------
        // Final exit
        // ----------------------------------------------------------------

        if smartExit or oppositeExit or protectionExit or emergencyExit
            exitShort := true

    // ========================================================================
    // EXIT POSITION
    // ========================================================================

    bool exitedThisBar = false

    if exitLong
        positionState := 0
        entryPrice := na
        highestPrice := na
        lowestPrice := na
        longTrailStop := na
        shortTrailStop := na
        exitedThisBar := true

    if exitShort
        positionState := 0
        entryPrice := na
        highestPrice := na
        lowestPrice := na
        longTrailStop := na
        shortTrailStop := na
        exitedThisBar := true

    // ========================================================================
    // NEW ENTRY
    // ========================================================================

    if positionState == 0 and not exitedThisBar

        if rawBuy
            newBuy := true
            positionState := 1
            entryPrice := close
            highestPrice := high
            lowestPrice := na
            longTrailStop := na
            shortTrailStop := na

        else if rawSell
            newSell := true
            positionState := -1
            entryPrice := close
            lowestPrice := low
            highestPrice := na
            longTrailStop := na
            shortTrailStop := na

// ============================================================================
// BUY / SELL SHAPES
// ============================================================================

plotshape(
     newBuy,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.normal)

plotshape(
     newSell,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.normal)

plotshape(
     exitLong,
     title="EXIT LONG",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.orange,
     text="EXIT",
     textcolor=color.white,
     size=size.normal)

plotshape(
     exitShort,
     title="EXIT SHORT",
     style=shape.labelup,
     location=location.belowbar,
     color=color.orange,
     text="EXIT",
     textcolor=color.white,
     size=size.normal)

// ============================================================================
// ENTRY PRICE
// ============================================================================

plot(
     positionState != 0 ? entryPrice : na,
     title="Entry Price",
     color=color.gray,
     linewidth=1,
     style=plot.style_linebr)

// ============================================================================
// PROTECTION PLOTS
// ============================================================================

float longProtection = na

if positionState == 1 and enableProtection
    if not na(longTrailStop)
        longProtection := longTrailStop
    else
        float currentProfitATR = (close - entryPrice) / exitATR
        if currentProfitATR >= activationATR
            longProtection := math.max(entryPrice, highestPrice - exitATR * trailATR)

float shortProtection = na

if positionState == -1 and enableProtection
    if not na(shortTrailStop)
        shortProtection := shortTrailStop
    else
        float currentProfitATR = (entryPrice - close) / exitATR
        if currentProfitATR >= activationATR
            shortProtection := math.min(entryPrice, lowestPrice + exitATR * trailATR)

plot(
     longProtection,
     title="Long Protection",
     color=color.orange,
     linewidth=2,
     style=plot.style_linebr)

plot(
     shortProtection,
     title="Short Protection",
     color=color.orange,
     linewidth=2,
     style=plot.style_linebr)

// ============================================================================
// BREAKOUT LINES
// ============================================================================

if newBuy and showBreakoutLines
    line.new(
         bar_index[1],
         high[1],
         bar_index,
         high[1],
         color=color.green,
         width=2,
         style=line.style_dashed)

if newSell and showBreakoutLines
    line.new(
         bar_index[1],
         low[1],
         bar_index,
         low[1],
         color=color.red,
         width=2,
         style=line.style_dashed)

// ============================================================================
// BAR COLOR
// ============================================================================

barcolor(
     showBarColors and newBuy ?
     color.lime :
     showBarColors and newSell ?
     color.red :
     exitLong or exitShort ?
     color.orange :
     na)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     newBuy,
     title="BUY Alert",
     message="BUY - EMA Cut Breakout")

alertcondition(
     newSell,
     title="SELL Alert",
     message="SELL - EMA Cut Breakout")

alertcondition(
     exitLong,
     title="EXIT LONG Alert",
     message="EXIT LONG - Smart Exit")

alertcondition(
     exitShort,
     title="EXIT SHORT Alert",
     message="EXIT SHORT - Smart Exit")

// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         9)

int dashboardExitScore = 0

if positionState == 1
    if close < exitEMA
        dashboardExitScore += 1
    if exitRSI < 50
        dashboardExitScore += 1
    if macdLine < macdSignal
        dashboardExitScore += 1
    if close < low[1]
        dashboardExitScore += 1

if positionState == -1
    if close > exitEMA
        dashboardExitScore += 1
    if exitRSI > 50
        dashboardExitScore += 1
    if macdLine > macdSignal
        dashboardExitScore += 1
    if close > high[1]
        dashboardExitScore += 1

if barstate.islast

    table.cell(dashboard, 0, 0, "POSITION")
    table.cell(dashboard, 1, 0, positionState == 1 ? "LONG" : positionState == -1 ? "SHORT" : "FLAT")

    table.cell(dashboard, 0, 1, "ENTRY")
    table.cell(dashboard, 1, 1, na(entryPrice) ? "-" : str.tostring(entryPrice, "#.##"))

    table.cell(dashboard, 0, 2, "RSI")
    table.cell(dashboard, 1, 2, str.tostring(exitRSI, "#.##"))

    table.cell(dashboard, 0, 3, "ATR")
    table.cell(dashboard, 1, 3, str.tostring(exitATR, "#.##"))

    table.cell(dashboard, 0, 4, "EXIT SCORE")
    table.cell(dashboard, 1, 4, str.tostring(dashboardExitScore) + "/4")

    table.cell(dashboard, 0, 5, "PROTECTION")
    table.cell(dashboard, 1, 5, (not na(longProtection) or not na(shortProtection)) ? "ACTIVE" : "WAIT")

    table.cell(dashboard, 0, 6, "OPPOSITE")
    table.cell(dashboard, 1, 6, positionState == 1 and rawSell ? "EXIT LONG" : positionState == -1 and rawBuy ? "EXIT SHORT" : "NONE")

    table.cell(dashboard, 0, 7, "SMART EXIT")
    table.cell(dashboard, 1, 7, enableSmartExit ? "ON" : "OFF")

    table.cell(dashboard, 0, 8, "STATUS")
    table.cell(dashboard, 1, 8, exitLong or exitShort ? "EXIT" : positionState == 1 ? "HOLD LONG" : positionState == -1 ? "HOLD SHORT" : "WAIT")
