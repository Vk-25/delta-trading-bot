//@version=5
indicator("EMA Cut Breakout [Universal Smart Exit] - FIXED", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// INPUTS
// ============================================================================

emaLength = input.int(20, "Entry EMA Length", minval=1, group="ENTRY")

showBarColors = input.bool(
     true,
     "Color Signal Candles",
     group="ENTRY")

showBreakoutLines = input.bool(
     true,
     "Show Breakout Lines",
     group="ENTRY")

// FIX #2: New input to stop signals from repainting on live/real markets.
// When true, all position/state changes only commit once the current bar
// is confirmed (closed). This is what makes the indicator behave the same
// live as it does in backtest/replay.
confirmOnBarClose = input.bool(
     true,
     "Confirm Signals On Bar Close (recommended for live/real markets)",
     group="ENTRY")

// ---------------- EXIT ----------------

enableSmartExit = input.bool(
     true,
     "Enable Smart Exit",
     group="EXIT")

exitOnOpposite = input.bool(
     true,
     "Exit On Opposite Signal",
     group="EXIT")

exitConfirmations = input.int(
     2,
     "Required Exit Confirmations",
     minval=1,
     maxval=4,
     group="EXIT")

// ---------------- EXIT INDICATORS ----------------

exitEMALength = input.int(
     20,
     "Exit EMA Length",
     minval=1,
     group="EXIT INDICATORS")

rsiLength = input.int(
     14,
     "RSI Length",
     minval=1,
     group="EXIT INDICATORS")

atrLength = input.int(
     14,
     "ATR Length",
     minval=1,
     group="EXIT INDICATORS")

// ---------------- PROFIT PROTECTION ----------------

enableProtection = input.bool(
     true,
     "Enable Profit Protection",
     group="PROTECTION")

activationATR = input.float(
     1.0,
     "Activation ATR",
     minval=0.1,
     step=0.1,
     group="PROTECTION")

trailATR = input.float(
     1.25,
     "Trailing ATR Distance",
     minval=0.1,
     step=0.05,
     group="PROTECTION")

// ---------------- EMERGENCY ----------------

enableEmergency = input.bool(
     true,
     "Enable Emergency Exit",
     group="RISK")

emergencyATR = input.float(
     2.5,
     "Emergency Loss ATR",
     minval=0.5,
     step=0.1,
     group="RISK")

// ============================================================================
// EMA
// ============================================================================

entryEMA = ta.ema(close, emaLength)

exitEMA = ta.ema(close, exitEMALength)

plot(
     entryEMA,
     title="Entry EMA",
     color=color.blue,
     linewidth=2)

// ============================================================================
// YOUR ORIGINAL ENTRY LOGIC
// ============================================================================

emaCuttingCandle =
     high[1] >= entryEMA[1] and
     low[1] <= entryEMA[1]

// ============================================================================
// RAW BUY / SELL
// ============================================================================

bool rawBuy = false
bool rawSell = false

if emaCuttingCandle

    bool breakHigh = high > high[1]
    bool breakLow = low < low[1]

    if breakHigh and breakLow

        if close > close[1]
            rawBuy := true

        else if close < close[1]
            rawSell := true

    else if breakHigh
        rawBuy := true

    else if breakLow
        rawSell := true

// ============================================================================
// EXIT INDICATORS
// ============================================================================

exitRSI = ta.rsi(close, rsiLength)

exitATR = ta.atr(atrLength)

[macdLine, macdSignal, macdHistogram] =
     ta.macd(close, 12, 26, 9)

// ============================================================================
// POSITION STATE
// ============================================================================
//
//  0 = FLAT
//  1 = LONG
// -1 = SHORT
//
// ============================================================================

var int positionState = 0

var float entryPrice = na

var float highestPrice = na

var float lowestPrice = na

// ============================================================================
// EXIT SIGNALS
// ============================================================================

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

// Exact price + reason the exit fired at, for precise on-chart marking.
float exitPrice = na
string exitReason = na

// ============================================================================
// FIX #2 (continued): everything below that MUTATES persisted state
// (positionState, entryPrice, highestPrice, lowestPrice) is now gated so it
// only runs once the bar is confirmed, unless the user disables that option.
// rawBuy/rawSell above are still computed every tick (harmless, no state),
// but the actual position flips/exits wait for bar close by default.
// ============================================================================

bool canProcess = barstate.isconfirmed or not confirmOnBarClose

if canProcess

    // ========================================================================
    // LONG MANAGEMENT
    // ========================================================================

    if positionState == 1

        // Track highest price

        if na(highestPrice)
            highestPrice := high
        else
            highestPrice := math.max(highestPrice, high)

        // ----------------------------------------------------------------
        // Exit confirmations
        // ----------------------------------------------------------------

        bool emaWeak =
             close < exitEMA

        bool rsiWeak =
             exitRSI < 50

        bool macdWeak =
             macdLine < macdSignal

        bool structureWeak =
             close < low[1]

        int longScore = 0

        if emaWeak
            longScore += 1

        if rsiWeak
            longScore += 1

        if macdWeak
            longScore += 1

        if structureWeak
            longScore += 1

        // ----------------------------------------------------------------
        // Smart exit
        // ----------------------------------------------------------------

        bool smartExit =
             enableSmartExit and
             longScore >= exitConfirmations

        // ----------------------------------------------------------------
        // Opposite signal
        // ----------------------------------------------------------------

        bool oppositeExit =
             exitOnOpposite and
             rawSell

        // ----------------------------------------------------------------
        // Profit protection
        // ----------------------------------------------------------------

        float longProfitATR =
             (close - entryPrice) / exitATR

        bool protectionActive =
             enableProtection and
             longProfitATR >= activationATR

        float trailingStop =
             highestPrice -
             exitATR * trailATR

        // Never let protection go below entry

        float protectedStop =
             math.max(
                 entryPrice,
                 trailingStop)

        bool protectionExit =
             protectionActive and
             close <= protectedStop

        // ----------------------------------------------------------------
        // Emergency loss
        // ----------------------------------------------------------------

        bool emergencyExit =
             enableEmergency and
             longProfitATR <= -emergencyATR

        // ----------------------------------------------------------------
        // Final exit
        // ----------------------------------------------------------------

        if smartExit or oppositeExit or protectionExit or emergencyExit
            exitLong := true

            // FIX #3: mark the EXACT price the exit triggered at, not just
            // the bar's high/low. A protection exit fires the moment price
            // touches the trailing stop, so that IS the exit price - not
            // the bar's close (which may have moved further by bar close,
            // especially on a live/forming candle).
            exitPrice := protectionExit ? protectedStop : close

            exitReason :=
                 protectionExit ? "Trail Stop" :
                 emergencyExit ? "Emergency" :
                 oppositeExit ? "Opposite Signal" :
                 "Smart Exit"

    // ========================================================================
    // SHORT MANAGEMENT
    // ========================================================================

    if positionState == -1

        // Track lowest price

        if na(lowestPrice)
            lowestPrice := low
        else
            lowestPrice := math.min(lowestPrice, low)

        // ----------------------------------------------------------------
        // Exit confirmations
        // ----------------------------------------------------------------

        bool emaWeak =
             close > exitEMA

        bool rsiWeak =
             exitRSI > 50

        bool macdWeak =
             macdLine > macdSignal

        bool structureWeak =
             close > high[1]

        int shortScore = 0

        if emaWeak
            shortScore += 1

        if rsiWeak
            shortScore += 1

        if macdWeak
            shortScore += 1

        if structureWeak
            shortScore += 1

        // ----------------------------------------------------------------
        // Smart exit
        // ----------------------------------------------------------------

        bool smartExit =
             enableSmartExit and
             shortScore >= exitConfirmations

        // ----------------------------------------------------------------
        // Opposite signal
        // ----------------------------------------------------------------

        bool oppositeExit =
             exitOnOpposite and
             rawBuy

        // ----------------------------------------------------------------
        // Profit protection
        // ----------------------------------------------------------------

        float shortProfitATR =
             (entryPrice - close) / exitATR

        bool protectionActive =
             enableProtection and
             shortProfitATR >= activationATR

        float trailingStop =
             lowestPrice +
             exitATR * trailATR

        // Never let protection go above entry

        float protectedStop =
             math.min(
                 entryPrice,
                 trailingStop)

        bool protectionExit =
             protectionActive and
             close >= protectedStop

        // ----------------------------------------------------------------
        // Emergency loss
        // ----------------------------------------------------------------

        bool emergencyExit =
             enableEmergency and
             shortProfitATR <= -emergencyATR

        // ----------------------------------------------------------------
        // Final exit
        // ----------------------------------------------------------------

        if smartExit or oppositeExit or protectionExit or emergencyExit
            exitShort := true

            exitPrice := protectionExit ? protectedStop : close

            exitReason :=
                 protectionExit ? "Trail Stop" :
                 emergencyExit ? "Emergency" :
                 oppositeExit ? "Opposite Signal" :
                 "Smart Exit"

    // ========================================================================
    // EXIT POSITION
    // ========================================================================
    //
    // IMPORTANT:
    // If we exit on this candle, we DO NOT open another position
    // on the same candle.
    //
    // ========================================================================

    bool exitedThisBar = false

    if exitLong

        positionState := 0

        entryPrice := na

        highestPrice := na

        lowestPrice := na

        exitedThisBar := true

    if exitShort

        positionState := 0

        entryPrice := na

        highestPrice := na

        lowestPrice := na

        exitedThisBar := true

    // ========================================================================
    // NEW ENTRY
    // ========================================================================

    // Only allow a new entry if:
    //
    // 1. Currently flat
    // 2. We did NOT exit on this candle
    //
    // ========================================================================

    if positionState == 0 and not exitedThisBar

        if rawBuy

            newBuy := true

            positionState := 1

            entryPrice := close

            highestPrice := high

            lowestPrice := na

        else if rawSell

            newSell := true

            positionState := -1

            entryPrice := close

            lowestPrice := low

            highestPrice := na

// ============================================================================
// BUY
// ============================================================================

plotshape(
     newBuy,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.normal)

// ============================================================================
// SELL
// ============================================================================

plotshape(
     newSell,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.normal)

// ============================================================================
// EXIT LONG / EXIT SHORT - triangle marked at the EXACT exit price
// ============================================================================
//
// FIX #3: previously this used a text label. Now it's a small triangle
// plotted with location.absolute, using exitPrice (the real trailing-stop
// touch price, or close for signal/emergency exits) as the y-value - so the
// triangle sits exactly on the price level where the position closed,
// instead of floating near the bar's high/low.
// ============================================================================

plotshape(
     exitLong ? exitPrice : na,
     title="EXIT LONG",
     style=shape.triangledown,
     location=location.absolute,
     color=color.orange,
     size=size.tiny)

plotshape(
     exitShort ? exitPrice : na,
     title="EXIT SHORT",
     style=shape.triangleup,
     location=location.absolute,
     color=color.orange,
     size=size.tiny)

// ============================================================================
// ENTRY PRICE
// ============================================================================

plot(
     positionState != 0 ? entryPrice : na,
     title="Entry Price",
     color=color.gray,
     linewidth=1,
     style=plot.style_linebr)

// ============================================================================
// LONG PROTECTION
// ============================================================================

float longProtection = na

if positionState == 1 and enableProtection

    float currentProfitATR =
         (close - entryPrice) / exitATR

    if currentProfitATR >= activationATR

        longProtection :=
             math.max(
                 entryPrice,
                 highestPrice - exitATR * trailATR)

// ============================================================================
// SHORT PROTECTION
// ============================================================================

float shortProtection = na

if positionState == -1 and enableProtection

    float currentProfitATR =
         (entryPrice - close) / exitATR

    if currentProfitATR >= activationATR

        shortProtection :=
             math.min(
                 entryPrice,
                 lowestPrice + exitATR * trailATR)

// ============================================================================
// PROTECTION PLOTS
// ============================================================================

plot(
     longProtection,
     title="Long Protection",
     color=color.orange,
     linewidth=2,
     style=plot.style_linebr)

plot(
     shortProtection,
     title="Short Protection",
     color=color.orange,
     linewidth=2,
     style=plot.style_linebr)

// ============================================================================
// BREAKOUT LINES
// ============================================================================

if newBuy and showBreakoutLines

    line.new(
         bar_index[1],
         high[1],
         bar_index,
         high[1],
         color=color.green,
         width=2,
         style=line.style_dashed)

if newSell and showBreakoutLines

    line.new(
         bar_index[1],
         low[1],
         bar_index,
         low[1],
         color=color.red,
         width=2,
         style=line.style_dashed)

// ============================================================================
// BAR COLOR
// ============================================================================

barcolor(
     showBarColors and newBuy ?
     color.lime :
     showBarColors and newSell ?
     color.red :
     exitLong or exitShort ?
     color.orange :
     na)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     newBuy,
     title="BUY Alert",
     message="BUY - EMA Cut Breakout")

alertcondition(
     newSell,
     title="SELL Alert",
     message="SELL - EMA Cut Breakout")

alertcondition(
     exitLong,
     title="EXIT LONG Alert",
     message="EXIT LONG - Smart Exit")

alertcondition(
     exitShort,
     title="EXIT SHORT Alert",
     message="EXIT SHORT - Smart Exit")

// ============================================================================
// DASHBOARD
// ============================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         9)

int dashboardExitScore = 0

if positionState == 1

    if close < exitEMA
        dashboardExitScore += 1

    if exitRSI < 50
        dashboardExitScore += 1

    if macdLine < macdSignal
        dashboardExitScore += 1

    if close < low[1]
        dashboardExitScore += 1

if positionState == -1

    if close > exitEMA
        dashboardExitScore += 1

    if exitRSI > 50
        dashboardExitScore += 1

    if macdLine > macdSignal
        dashboardExitScore += 1

    if close > high[1]
        dashboardExitScore += 1

if barstate.islast

    table.cell(
         dashboard,
         0,
         0,
         "POSITION")

    table.cell(
         dashboard,
         1,
         0,
         positionState == 1 ?
         "LONG" :
         positionState == -1 ?
         "SHORT" :
         "FLAT")

    table.cell(
         dashboard,
         0,
         1,
         "ENTRY")

    table.cell(
         dashboard,
         1,
         1,
         na(entryPrice) ?
         "-" :
         str.tostring(entryPrice, "#.##"))

    table.cell(
         dashboard,
         0,
         2,
         "RSI")

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(exitRSI, "#.##"))

    table.cell(
         dashboard,
         0,
         3,
         "ATR")

    table.cell(
         dashboard,
         1,
         3,
         str.tostring(exitATR, "#.##"))

    table.cell(
         dashboard,
         0,
         4,
         "EXIT SCORE")

    table.cell(
         dashboard,
         1,
         4,
         str.tostring(dashboardExitScore) + "/4")

    table.cell(
         dashboard,
         0,
         5,
         "PROTECTION")

    // FIX #1: "longProtection or shortProtection" was comparing two floats
    // with the boolean "or" operator, which does not compile in Pine Script.
    // Corrected to properly check for a non-na (active) protection value.
    table.cell(
         dashboard,
         1,
         5,
         (not na(longProtection) or not na(shortProtection)) ?
         "ACTIVE" :
         "WAIT")

    table.cell(
         dashboard,
         0,
         6,
         "OPPOSITE")

    table.cell(
         dashboard,
         1,
         6,
         positionState == 1 and rawSell ?
         "EXIT LONG" :
         positionState == -1 and rawBuy ?
         "EXIT SHORT" :
         "NONE")

    table.cell(
         dashboard,
         0,
         7,
         "SMART EXIT")

    table.cell(
         dashboard,
         1,
         7,
         enableSmartExit ?
         "ON" :
         "OFF")

    table.cell(
         dashboard,
         0,
         8,
         "STATUS")

    table.cell(
         dashboard,
         1,
         8,
         exitLong or exitShort ?
         "EXIT" :
         positionState == 1 ?
         "HOLD LONG" :
         positionState == -1 ?
         "HOLD SHORT" :
         "WAIT")
