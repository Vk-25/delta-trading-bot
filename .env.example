# =====================================================================
# DELTA EXCHANGE CONFIGURATION
# =====================================================================
# Options: 'global' (https://api.delta.exchange) or 'india' (https://api.india.delta.exchange)
DELTA_ENVIRONMENT=india

# Your API Key and API Secret from Delta Exchange -> Settings -> API Keys
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Passphrase for securing TradingView Webhook requests
WEBHOOK_PASSPHRASE=supersecretpassphrase123

# Default Trading Symbol (e.g. BTCUSD, ETHUSD, SOLUSD)
TRADING_SYMBOL=ETHUSD

# Order size in contracts (e.g. 1, 10, 100)
ORDER_SIZE=1

# Default Leverage (e.g., 5, 10, 25, 100)
LEVERAGE=100

# Order Type for Webhook/Bot execution: market_order or limit_order
ORDER_TYPE=market_order

# =====================================================================
# STRATEGY & INDICATOR PARAMETERS (EMA Cut Breakout Universal Smart Exit)
# =====================================================================
ENTRY_EMA_LENGTH=21

ENABLE_SMART_EXIT=true
EXIT_ON_OPPOSITE=true
EXIT_CONFIRMATIONS=2
EXIT_EMA_LENGTH=21
RSI_LENGTH=14
ATR_LENGTH=14

# Entry Refinements (Option A: Strict 21 EMA Cut Breakout ONLY)
ENABLE_LIVE_ENTRIES=true
ENABLE_TREND_CONTINUATION=false

# Capital Protection & Zero-Loss Auto-Breakeven
ENABLE_BREAKEVEN=true
BREAKEVEN_ATR=0.85
FEE_BUFFER_USD=1.5

# Profit Protection & Real-time Trailing Stop
ENABLE_PROTECTION=true
ENABLE_INTRA_CANDLE_EXIT=true
ACTIVATION_ATR=1.0
TRAIL_ATR=0.85
TAKE_PROFIT_ATR=0.0

# Emergency Stop
ENABLE_EMERGENCY=true
EMERGENCY_ATR=1.50

# Standalone Bot Settings
TIMEFRAME=15m
POLL_INTERVAL_SECONDS=1
