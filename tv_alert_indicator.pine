//@version=6
indicator("DeltaBot 21 EMA Cut Breakout & 1:3 Trailing Profit", overlay=true, max_lines_count=500, max_boxes_count=100)

// ============================================================================
// STRATEGY CORE INPUTS
// ============================================================================

entryEMALength = input.int(21, "Entry 21 EMA Length", minval=1, group="INDICATOR SETTINGS")
fastEMALength = input.int(9, "Trend & Momentum 9 EMA Length", minval=1, group="INDICATOR SETTINGS")

enableDynamicLots = input.bool(true, "Enable Dynamic Lots (1 to 3 Lots for Gold)", group="DYNAMIC SIZING")
minLots = input.int(1, "Minimum Lots", minval=1, maxval=3, group="DYNAMIC SIZING")
maxLots = input.int(3, "Maximum Lots", minval=1, maxval=5, group="DYNAMIC SIZING")

enable1to3Trailing = input.bool(true, "Enable 1:3 Trailing Take Profit", group="TRAILING STOP MANAGEMENT")
trailMoveUnit = input.float(3.0, "Market Move Unit (Points)", minval=0.1, step=0.5, group="TRAILING STOP MANAGEMENT")
trailStepUnit = input.float(1.0, "Trail Step Unit (Points)", minval=0.1, step=0.5, group="TRAILING STOP MANAGEMENT")
exitOnOpposite = input.bool(true, "Exit & Stay Flat on Opposite Signal", group="TRAILING STOP MANAGEMENT")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

ema21 = ta.ema(close, entryEMALength)
ema9 = ta.ema(close, fastEMALength)

plot(ema21, title="21 Entry EMA", color=color.rgb(6, 182, 212), linewidth=2)
plot(ema9, title="9 Momentum EMA", color=color.rgb(245, 158, 11), linewidth=1)

// ============================================================================
// 21 EMA BODY-CUT & IMMEDIATE 1-CANDLE BREAKOUT LOGIC
// ============================================================================

// 1. Detect 21 EMA Body-Cut on Previous Candle [1]
prevBodyTop = math.max(open[1], close[1])
prevBodyBottom = math.min(open[1], close[1])
ema21Cut = (prevBodyBottom <= ema21[1]) and (prevBodyTop >= ema21[1])

// Highlight 21 EMA Cut candles
barcolor(ema21Cut ? color.rgb(139, 92, 246, 30) : na, title="21 EMA Cut Candle Highlight")

// 2. Breakouts on Current Immediate Candle [0]
bool buyBreakout = ema21Cut and high > high[1]
bool sellBreakout = ema21Cut and low < low[1]

// ============================================================================
// DYNAMIC LOT SIZING CALCULATION (1 to 3 Lots for Gold)
// ============================================================================

calcDynamicLots(actionStr) =>
    int score = 1
    bool trendAligned = (actionStr == "BUY" and ema9 > ema21) or (actionStr == "SELL" and ema9 < ema21)
    if trendAligned
        score += 1
    bool candleMom = (actionStr == "BUY" and close[1] >= open[1]) or (actionStr == "SELL" and close[1] <= open[1])
    bool priceMom = (actionStr == "BUY" and close > ema9) or (actionStr == "SELL" and close < ema9)
    if candleMom and priceMom
        score += 1
    math.max(minLots, math.min(maxLots, score))

// ============================================================================
// POSITION STATE MACHINE & 1:3 TRAILING TAKE PROFIT
// ============================================================================

var int positionState = 0        // 0 = Flat, 1 = Long, -1 = Short
var float entryPrice = na
var float initialStop = na
var float activeTrailingStop = na
var float highestPrice = na
var float lowestPrice = na
var int activeLots = 1

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

float trailRatio = trailMoveUnit > 0 ? (trailStepUnit / trailMoveUnit) : (1.0 / 3.0)

// ---------------- LONG POSITION MANAGEMENT ----------------
if positionState == 1
    highestPrice := na(highestPrice) ? high : math.max(highestPrice, high)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = highestPrice - entryPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop + trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.max(activeTrailingStop, candidateStop)
    
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close <= activeTrailingStop
    
    // Check Opposite Signal Exit (Close to Flat)
    bool oppositeHit = exitOnOpposite and sellBreakout
    
    if stopHit or oppositeHit
        exitLong := true

// ---------------- SHORT POSITION MANAGEMENT ----------------
if positionState == -1
    lowestPrice := na(lowestPrice) ? low : math.min(lowestPrice, low)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = entryPrice - lowestPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop - trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.min(activeTrailingStop, candidateStop)
            
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close >= activeTrailingStop
    
    // Check Opposite Signal Exit (Close to Flat)
    bool oppositeHit = exitOnOpposite and buyBreakout
    
    if stopHit or oppositeHit
        exitShort := true

// ---------------- HANDLE EXITS ----------------
bool exitedThisBar = false

if exitLong
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na
    exitedThisBar := true

if exitShort
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na
    exitedThisBar := true

// ---------------- HANDLE NEW ENTRIES ----------------
if positionState == 0 and not exitedThisBar
    if buyBreakout
        newBuy := true
        positionState := 1
        entryPrice := close
        highestPrice := high
        lowestPrice := na
        initialStop := low[1]
        activeTrailingStop := low[1]
        activeLots := enableDynamicLots ? calcDynamicLots("BUY") : 1
    else if sellBreakout
        newSell := true
        positionState := -1
        entryPrice := close
        lowestPrice := low
        highestPrice := na
        initialStop := high[1]
        activeTrailingStop := high[1]
        activeLots := enableDynamicLots ? calcDynamicLots("SELL") : 1

// ============================================================================
// VISUAL SIGNALS & LABELS
// ============================================================================

string buyLabelText = "21 CUT BUY" + (enableDynamicLots ? " (" + str.tostring(calcDynamicLots("BUY")) + " Lots)" : "")
string sellLabelText = "21 CUT SELL" + (enableDynamicLots ? " (" + str.tostring(calcDynamicLots("SELL")) + " Lots)" : "")

plotshape(newBuy, title="BUY Entry", style=shape.labelup, location=location.belowbar, color=color.rgb(16, 185, 129), text=buyLabelText, textcolor=color.white, size=size.normal)
plotshape(newSell, title="SELL Entry", style=shape.labeldown, location=location.abovebar, color=color.rgb(239, 68, 68), text=sellLabelText, textcolor=color.white, size=size.normal)
plotshape(exitLong, title="EXIT LONG", style=shape.labeldown, location=location.abovebar, color=color.rgb(245, 158, 11), text="EXIT LONG (1:3 TRAIL)", textcolor=color.white, size=size.small)
plotshape(exitShort, title="EXIT SHORT", style=shape.labelup, location=location.belowbar, color=color.rgb(245, 158, 11), text="EXIT SHORT (1:3 TRAIL)", textcolor=color.white, size=size.small)

// Active 1:3 Trailing Stop Line
plot(activeTrailingStop, title="1:3 Trailing Stop", color=color.rgb(239, 68, 68), linewidth=2, style=plot.style_linebr)

// Entry Price Reference
plot(positionState != 0 ? entryPrice : na, title="Entry Price", color=color.rgb(148, 163, 184), linewidth=1, style=plot.style_circles)

// ============================================================================
// LIVE HUD DASHBOARD TABLE (TOP RIGHT OF CHART)
// ============================================================================

var table hud = table.new(position.top_right, 2, 7, bgcolor=color.rgb(15, 23, 42, 20), border_color=color.rgb(255, 255, 255, 15), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Bot Strategy", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 0, "21 EMA Cut 1:3 Trail", text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 1, "Position State", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string posStr = positionState == 1 ? "LONG 🟢 (" + str.tostring(activeLots) + " Lots)" : (positionState == -1 ? "SHORT 🔴 (" + str.tostring(activeLots) + " Lots)" : "FLAT ⚪ (Monitoring)")
    color posCol = positionState == 1 ? color.rgb(16, 185, 129) : (positionState == -1 ? color.rgb(239, 68, 68) : color.rgb(148, 163, 184))
    table.cell(hud, 1, 1, posStr, text_color=posCol, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 2, not na(entryPrice) ? "$" + str.tostring(entryPrice, "#.##") : "--", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "1:3 Trailing Stop", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 3, not na(activeTrailingStop) ? "$" + str.tostring(activeTrailingStop, "#.##") : "--", text_color=color.rgb(239, 68, 68), text_size=size.small)

    table.cell(hud, 0, 4, "21 Entry EMA", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 4, "$" + str.tostring(ema21, "#.##"), text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 5, "9 Momentum EMA", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string ema9Trend = close > ema9 ? "BULLISH 🟢" : "BEARISH 🔴"
    table.cell(hud, 1, 5, "$" + str.tostring(ema9, "#.##") + " (" + ema9Trend + ")", text_color=color.rgb(245, 158, 11), text_size=size.small)

    table.cell(hud, 0, 6, "Symbol Profile", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string profText = syminfo.ticker == "ETHUSD" ? "ETH (130x · 1 Lot)" : (str.contains(syminfo.ticker, "XAU") ? "GOLD (60x · 1-3 Lots)" : syminfo.ticker)
    table.cell(hud, 1, 6, profText, text_color=color.rgb(245, 158, 11), text_size=size.small)
