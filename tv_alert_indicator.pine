//@version=6
indicator("DeltaBot 21 EMA Cut Breakout & 1:3 Trailing Profit", overlay=true)

// ============================================================================
// STRATEGY CORE INPUTS
// ============================================================================

entryEMALength = input.int(21, "Entry 21 EMA Length", minval=1, group="INDICATOR SETTINGS")
fastEMALength = input.int(9, "Trend & Momentum 9 EMA Length", minval=1, group="INDICATOR SETTINGS")

enable1to3Trailing = input.bool(true, "Enable 1:3 Trailing Take Profit", group="TRAILING STOP MANAGEMENT")
trailMoveUnit = input.float(3.0, "Market Move Unit (Points)", minval=0.1, step=0.5, group="TRAILING STOP MANAGEMENT")
trailStepUnit = input.float(1.0, "Trail Step Unit (Points)", minval=0.1, step=0.5, group="TRAILING STOP MANAGEMENT")
exitOnOpposite = input.bool(true, "Exit & Stay Flat on Opposite Signal", group="TRAILING STOP MANAGEMENT")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

ema21 = ta.ema(close, entryEMALength)
ema9 = ta.ema(close, fastEMALength)

plot(ema21, title="21 Entry EMA", color=color.new(color.aqua, 0), linewidth=2)
plot(ema9, title="9 Momentum EMA", color=color.new(color.orange, 0), linewidth=1)

// ============================================================================
// 21 EMA BODY-CUT & IMMEDIATE 1-CANDLE BREAKOUT LOGIC
// ============================================================================

// 1. Detect 21 EMA Body-Cut on Previous Candle [1]
prevBodyTop = math.max(open[1], close[1])
prevBodyBottom = math.min(open[1], close[1])
ema21Cut = (prevBodyBottom <= ema21[1]) and (prevBodyTop >= ema21[1])

// Highlight 21 EMA Cut candles
barcolor(ema21Cut ? color.new(color.purple, 30) : na, title="21 EMA Cut Candle Highlight")

// 2. Breakouts on Current Immediate Candle [0]
bool buyBreakout = ema21Cut and high > high[1]
bool sellBreakout = ema21Cut and low < low[1]

// ============================================================================
// POSITION STATE MACHINE & 1:3 TRAILING TAKE PROFIT
// ============================================================================

var int positionState = 0        // 0 = Flat, 1 = Long, -1 = Short
var float entryPrice = na
var float initialStop = na
var float activeTrailingStop = na
var float highestPrice = na
var float lowestPrice = na

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

float trailRatio = trailMoveUnit > 0 ? (trailStepUnit / trailMoveUnit) : (1.0 / 3.0)

// ---------------- LONG POSITION MANAGEMENT ----------------
if positionState == 1
    highestPrice := na(highestPrice) ? high : math.max(highestPrice, high)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = highestPrice - entryPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop + trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.max(activeTrailingStop, candidateStop)
    
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close <= activeTrailingStop
    if stopHit
        exitLong := true

// ---------------- SHORT POSITION MANAGEMENT ----------------
if positionState == -1
    lowestPrice := na(lowestPrice) ? low : math.min(lowestPrice, low)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = entryPrice - lowestPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop - trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.min(activeTrailingStop, candidateStop)
            
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close >= activeTrailingStop
    if stopHit
        exitShort := true

// ---------------- HANDLE BREAKOUT REVERSALS & ENTRIES ----------------
if buyBreakout
    if positionState == -1
        exitShort := true
    newBuy := true
    positionState := 1
    entryPrice := close
    highestPrice := high
    lowestPrice := na
    initialStop := low[1]
    activeTrailingStop := low[1]

else if sellBreakout
    if positionState == 1
        exitLong := true
    newSell := true
    positionState := -1
    entryPrice := close
    lowestPrice := low
    highestPrice := na
    initialStop := high[1]
    activeTrailingStop := high[1]

else if exitLong
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na

else if exitShort
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na

// ============================================================================
// VISUAL SIGNALS & LABELS
// ============================================================================

plotshape(newBuy, title="BUY Entry", style=shape.labelup, location=location.belowbar, color=color.green, text="21 CUT BUY", textcolor=color.white, size=size.normal)
plotshape(newSell, title="SELL Entry", style=shape.labeldown, location=location.abovebar, color=color.red, text="21 CUT SELL", textcolor=color.white, size=size.normal)
plotshape(exitLong and not newSell, title="EXIT LONG", style=shape.labeldown, location=location.abovebar, color=color.orange, text="EXIT 1:3", textcolor=color.white, size=size.small)
plotshape(exitShort and not newBuy, title="EXIT SHORT", style=shape.labelup, location=location.belowbar, color=color.orange, text="EXIT 1:3", textcolor=color.white, size=size.small)

// Active 1:3 Trailing Stop Line
plot(activeTrailingStop, title="1:3 Trailing Stop", color=color.red, linewidth=2, style=plot.style_linebr)

// Entry Price Reference
plot(positionState != 0 ? entryPrice : na, title="Entry Price", color=color.gray, linewidth=1, style=plot.style_circles)

// ============================================================================
// LIVE HUD DASHBOARD TABLE (TOP RIGHT OF CHART)
// ============================================================================

var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.navy, 20), border_color=color.new(color.gray, 60), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Strategy", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 0, "21 EMA Cut 1:3 Trail", text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 1, "Position State", text_color=color.silver, text_size=size.small)
    string posStr = positionState == 1 ? "LONG 🟢" : (positionState == -1 ? "SHORT 🔴" : "FLAT ⚪")
    color posCol = positionState == 1 ? color.green : (positionState == -1 ? color.red : color.silver)
    table.cell(hud, 1, 1, posStr, text_color=posCol, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 2, not na(entryPrice) ? "$" + str.tostring(entryPrice, "#.##") : "--", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "1:3 Trailing Stop", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 3, not na(activeTrailingStop) ? "$" + str.tostring(activeTrailingStop, "#.##") : "--", text_color=color.red, text_size=size.small)

    table.cell(hud, 0, 4, "21 Entry EMA", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 4, "$" + str.tostring(ema21, "#.##"), text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 5, "9 Momentum EMA", text_color=color.silver, text_size=size.small)
    string ema9Trend = close > ema9 ? "BULLISH 🟢" : "BEARISH 🔴"
    table.cell(hud, 1, 5, "$" + str.tostring(ema9, "#.##") + " (" + ema9Trend + ")", text_color=color.orange, text_size=size.small)
