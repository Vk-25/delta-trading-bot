//@version=6
indicator("DeltaBot 21 EMA Cut Breakout | 1:3 Trailing Scalper", overlay=true, max_lines_count=500, max_boxes_count=100)

// ============================================================================
// INPUTS & WEBHOOK SETTINGS
// ============================================================================

webhookPassphrase = input.string("supersecretpassphrase123", "Webhook Passphrase (match .env)", group="BOT AUTOMATION")

// Symbol Profile & Sizing Presets
symbolProfile = input.string("AUTO", "Symbol Profile", options=["AUTO", "ETHUSD (130x, 1 Lot)", "XAUTUSD (60x, 1-3 Lots)", "CUSTOM"], group="SYMBOL & LEVERAGE")
customOrderSize = input.int(1, "Order Size (Contracts)", minval=1, group="SYMBOL & LEVERAGE")

// Sizing logic
int orderSize = customOrderSize
if symbolProfile == "ETHUSD (130x, 1 Lot)"
    orderSize := 1
else if symbolProfile == "XAUTUSD (60x, 1-3 Lots)"
    orderSize := customOrderSize

// ---------------- STRATEGY CORE SETTINGS ----------------
entryEMALength = input.int(21, "Primary Entry 21 EMA Length", minval=1, group="CORE INDICATORS")
fastEMALength = input.int(9, "Analysis 9 EMA Length", minval=1, group="CORE INDICATORS")

// ---------------- 1:3 TRAILING TAKE PROFIT ----------------
enable1to3Trailing = input.bool(true, "Enable 1:3 Trailing Take Profit", group="PROFIT MANAGEMENT")
trailMoveUnit = input.float(3.0, "Market Move Unit (Points)", minval=0.1, step=0.5, group="PROFIT MANAGEMENT")
trailStepUnit = input.float(1.0, "Trail Step Unit (Points)", minval=0.1, step=0.5, group="PROFIT MANAGEMENT")
exitOnOpposite = input.bool(true, "Exit & Stay Flat on Opposite Signal", group="PROFIT MANAGEMENT")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

ema21 = ta.ema(close, entryEMALength)
ema9 = ta.ema(close, fastEMALength)

plot(ema21, title="21 Entry EMA", color=color.rgb(6, 182, 212), linewidth=2)
plot(ema9, title="9 Analysis EMA", color=color.rgb(245, 158, 11), linewidth=1)

// ============================================================================
// 21 EMA BODY-CUT & IMMEDIATE 1-CANDLE BREAKOUT LOGIC
// ============================================================================

// 1. Detect 21 EMA Body-Cut on Previous Candle [1]
prevBodyTop = math.max(open[1], close[1])
prevBodyBottom = math.min(open[1], close[1])
ema21Cut = (prevBodyBottom <= ema21[1]) and (prevBodyTop >= ema21[1])

// 2. Breakouts on Current Immediate Candle [0]
bool buyBreakout = ema21Cut and high > high[1]
bool sellBreakout = ema21Cut and low < low[1]

// ============================================================================
// POSITION STATE MACHINE & 1:3 TRAILING TAKE PROFIT
// ============================================================================

var int positionState = 0        // 0 = Flat, 1 = Long, -1 = Short
var float entryPrice = na
var float initialStop = na
var float activeTrailingStop = na
var float highestPrice = na
var float lowestPrice = na

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

float trailRatio = trailMoveUnit > 0 ? (trailStepUnit / trailMoveUnit) : (1.0 / 3.0)

// ---------------- LONG POSITION MANAGEMENT ----------------
if positionState == 1
    highestPrice := na(highestPrice) ? high : math.max(highestPrice, high)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = highestPrice - entryPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop + trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.max(activeTrailingStop, candidateStop)
    
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close <= activeTrailingStop
    
    // Check Opposite Signal Exit (Close to Flat)
    bool oppositeHit = exitOnOpposite and sellBreakout
    
    if stopHit or oppositeHit
        exitLong := true

// ---------------- SHORT POSITION MANAGEMENT ----------------
if positionState == -1
    lowestPrice := na(lowestPrice) ? low : math.min(lowestPrice, low)
    
    // 1:3 Trailing Stop Calculation
    if enable1to3Trailing and not na(entryPrice)
        float maxProfit = entryPrice - lowestPrice
        if maxProfit > 0
            float trailOffset = maxProfit * trailRatio
            float candidateStop = initialStop - trailOffset
            activeTrailingStop := na(activeTrailingStop) ? candidateStop : math.min(activeTrailingStop, candidateStop)
            
    // Check Trailing Stop Hit
    bool stopHit = not na(activeTrailingStop) and close >= activeTrailingStop
    
    // Check Opposite Signal Exit (Close to Flat)
    bool oppositeHit = exitOnOpposite and buyBreakout
    
    if stopHit or oppositeHit
        exitShort := true

// ---------------- HANDLE EXITS ----------------
bool exitedThisBar = false

if exitLong
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na
    exitedThisBar := true

if exitShort
    positionState := 0
    entryPrice := na
    initialStop := na
    activeTrailingStop := na
    highestPrice := na
    lowestPrice := na
    exitedThisBar := true

// ---------------- HANDLE NEW ENTRIES ----------------
if positionState == 0 and not exitedThisBar
    if buyBreakout
        newBuy := true
        positionState := 1
        entryPrice := close
        highestPrice := high
        lowestPrice := na
        initialStop := low[1]
        activeTrailingStop := low[1]
    else if sellBreakout
        newSell := true
        positionState := -1
        entryPrice := close
        lowestPrice := low
        highestPrice := na
        initialStop := high[1]
        activeTrailingStop := high[1]

// ============================================================================
// VISUAL PLOTS ON CHART
// ============================================================================

plotshape(newBuy, title="BUY Entry", style=shape.labelup, location=location.belowbar, color=color.rgb(16, 185, 129), text="21 CUT BUY", textcolor=color.white, size=size.normal)
plotshape(newSell, title="SELL Entry", style=shape.labeldown, location=location.abovebar, color=color.rgb(244, 63, 94), text="21 CUT SELL", textcolor=color.white, size=size.normal)
plotshape(exitLong, title="EXIT LONG", style=shape.labeldown, location=location.abovebar, color=color.rgb(245, 158, 11), text="EXIT LONG", textcolor=color.white, size=size.small)
plotshape(exitShort, title="EXIT SHORT", style=shape.labelup, location=location.belowbar, color=color.rgb(245, 158, 11), text="EXIT SHORT", textcolor=color.white, size=size.small)

// Active 1:3 Trailing Stop Line
plot(activeTrailingStop, title="1:3 Trailing Stop", color=color.rgb(239, 68, 68), linewidth=2, style=plot.style_linebr)

// Entry Price Reference
plot(positionState != 0 ? entryPrice : na, title="Entry Price", color=color.rgb(148, 163, 184), linewidth=1, style=plot.style_circles)

// ============================================================================
// HUD INFO TABLE (TOP RIGHT OF CHART)
// ============================================================================

var table hud = table.new(position.top_right, 2, 7, bgcolor=color.rgb(15, 23, 42, 20), border_color=color.rgb(255, 255, 255, 15), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Strategy", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 0, "21 EMA Cut 1:3 Trail", text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 1, "Position", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string posStr = positionState == 1 ? "LONG 🟢" : (positionState == -1 ? "SHORT 🔴" : "FLAT ⚪")
    color posCol = positionState == 1 ? color.rgb(16, 185, 129) : (positionState == -1 ? color.rgb(244, 63, 94) : color.rgb(148, 163, 184))
    table.cell(hud, 1, 1, posStr, text_color=posCol, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 2, not na(entryPrice) ? "$" + str.tostring(entryPrice, "#.##") : "--", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "1:3 Trailing Stop", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 3, not na(activeTrailingStop) ? "$" + str.tostring(activeTrailingStop, "#.##") : "--", text_color=color.rgb(244, 63, 94), text_size=size.small)

    table.cell(hud, 0, 4, "21 Entry EMA", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 4, "$" + str.tostring(ema21, "#.##"), text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 5, "9 Analysis EMA", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string ema9Trend = close > ema9 ? "BULLISH 🟢" : "BEARISH 🔴"
    table.cell(hud, 1, 5, "$" + str.tostring(ema9, "#.##") + " (" + ema9Trend + ")", text_color=color.rgb(245, 158, 11), text_size=size.small)

    table.cell(hud, 0, 6, "Profile Setup", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string profText = syminfo.ticker == "ETHUSD" ? "ETH 130x (1 Lot)" : (syminfo.ticker == "XAUTUSD" ? "XAUT 60x (" + str.tostring(orderSize) + " Lot)" : str.tostring(orderSize) + " Lot")
    table.cell(hud, 1, 6, profText, text_color=color.white, text_size=size.small)

// ============================================================================
// WEBHOOK ALERTS (EXCHANGE SYNCHRONIZED)
// ============================================================================

buyAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"BUY","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(low[1]) + '}'
sellAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"SELL","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(high[1]) + '}'
exitLongAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_LONG","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'
exitShortAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_SHORT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'

if newBuy
    alert(buyAlertMsg, alert.freq_once_per_bar)

if newSell
    alert(sellAlertMsg, alert.freq_once_per_bar)

if exitLong
    alert(exitLongAlertMsg, alert.freq_once_per_bar)

if exitShort
    alert(exitShortAlertMsg, alert.freq_once_per_bar)

alertcondition(newBuy, title="DeltaBot 21 CUT BUY Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"BUY","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(newSell, title="DeltaBot 21 CUT SELL Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"SELL","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitLong, title="DeltaBot EXIT LONG Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_LONG","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitShort, title="DeltaBot EXIT SHORT Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_SHORT","symbol":"{{ticker}}","price":{{close}}}')
