//@version=6
indicator("DeltaBot 100x | High-Frequency Scalper (60+ Trades/Day | 1m/3m/5m)", overlay=true, max_lines_count=500, max_boxes_count=100)

// ============================================================================
// INPUTS & WEBHOOK SETTINGS
// ============================================================================

webhookPassphrase = input.string("supersecretpassphrase123", "Webhook Passphrase (match .env)", group="BOT AUTOMATION")
orderSize = input.int(1, "Order Size (Contracts)", minval=1, group="BOT AUTOMATION")

// ---------------- HIGH-FREQUENCY SCALPER SETTINGS ----------------
fastEMALength = input.int(9, "Fast 9 EMA Length", minval=1, group="SCALPER TRIGGERS")
entryEMALength = input.int(21, "Entry 21 EMA Length", minval=1, group="SCALPER TRIGGERS")
enableLiveIntraBar = input.bool(true, "Execute Instantly on Signal (No bar delay)", group="SCALPER TRIGGERS")
enableTrendContinuation = input.bool(true, "Enable Pullback Bounce Scalps (Re-entries)", group="SCALPER TRIGGERS")
enableRangeBreakout = input.bool(true, "Enable 5-Bar Range Momentum Breakouts", group="SCALPER TRIGGERS")
enableRSIReversal = input.bool(true, "Enable RSI Extreme Snaps (Oversold/Overbought)", group="SCALPER TRIGGERS")

// ---------------- EXIT & CONFIRMATIONS ----------------
enableSmartExit = input.bool(true, "Enable Smart Exit", group="EXIT & CONFIRMATIONS")
exitOnOpposite = input.bool(true, "Exit & Reverse On Opposite Signal", group="EXIT & CONFIRMATIONS")
exitConfirmations = input.int(2, "Required Exit Confirmations (out of 4)", minval=1, maxval=4, group="EXIT & CONFIRMATIONS")

rsiLength = input.int(14, "RSI Length", minval=1, group="INDICATORS")
atrLength = input.int(14, "ATR Length", minval=1, group="INDICATORS")

// ---------------- ZERO-LOSS & PROFIT PROTECTION (SCALPER DEFAULTS) ----------------
enableBreakeven = input.bool(true, "Enable Zero-Loss Auto-Breakeven", group="PROTECTION")
breakevenATR = input.float(0.35, "Breakeven Trigger ATR", minval=0.1, step=0.05, group="PROTECTION")
feeBufferUSD = input.float(0.50, "Fee Buffer in USD", minval=0.1, step=0.1, group="PROTECTION")

enableProtection = input.bool(true, "Enable Profit Protection (Dynamic Trailing)", group="PROTECTION")
activationATR = input.float(0.50, "Trailing Activation ATR", minval=0.1, step=0.05, group="PROTECTION")
trailATR = input.float(0.45, "Trailing Distance ATR", minval=0.1, step=0.05, group="PROTECTION")
takeProfitATR = input.float(0.85, "Fast Scalp Take-Profit ATR (0 to disable)", minval=0.0, step=0.05, group="PROTECTION")

enableEmergency = input.bool(true, "Enable Emergency Loss Exit", group="RISK & ANTI-LIQUIDATION")
emergencyATR = input.float(1.10, "Emergency Loss ATR", minval=0.1, step=0.05, group="RISK & ANTI-LIQUIDATION")

// ---------------- SMART ENTRY FILTERS ----------------
enableVolumeFilter = input.bool(true, "Enable Volume Filter (Reject Zero-Vol Bars)", group="SMART FILTERS")
volumeMultiplier = input.float(1.1, "Volume Multiplier (xAvg)", minval=0.5, step=0.1, group="SMART FILTERS")
volumeLookback = input.int(20, "Volume Lookback Bars", minval=5, group="SMART FILTERS")

enableADXFilter = input.bool(false, "Enable ADX Filter (Disabled for pure fast scalping)", group="SMART FILTERS")
adxLength = input.int(14, "ADX Length", minval=5, group="SMART FILTERS")
minADX = input.float(15.0, "Min ADX for Entry", minval=5.0, step=1.0, group="SMART FILTERS")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

fastEMA = ta.ema(close, fastEMALength)
entryEMA = ta.ema(close, entryEMALength)
exitRSI = ta.rsi(close, rsiLength)
exitATR = ta.atr(atrLength)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

// 5-bar range high / low for micro breakouts
rangeHigh5 = ta.highest(high[1], 5)
rangeLow5 = ta.lowest(low[1], 5)

// ADX Calculation
dirmov(len) =>
    upMove = ta.change(high)
    downMove = -ta.change(low)
    plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
    trueRange = ta.rma(ta.tr, len)
    plusDI = 100 * ta.rma(plusDM, len) / trueRange
    minusDI = 100 * ta.rma(minusDM, len) / trueRange
    [plusDI, minusDI]

[plusDI, minusDI] = dirmov(adxLength)
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxValue = ta.rma(dx, adxLength)

// Volume Confirmation
volAvg = ta.sma(volume, volumeLookback)
volConfirmed = not enableVolumeFilter or (volume > (volAvg * volumeMultiplier))

plot(fastEMA, title="9 Fast EMA", color=color.rgb(245, 158, 11), linewidth=1)
plot(entryEMA, title="21 Entry EMA", color=color.rgb(6, 182, 212), linewidth=2)

// ============================================================================
// HIGH-FREQUENCY MULTI-TRIGGER SCALPING LOGIC (60+ Trades/Day)
// ============================================================================

// 1. Dual EMA Cross & Cut Breakout
bodyTop = math.max(open[1], close[1])
bodyBottom = math.min(open[1], close[1])
emaCuttingCandle = bodyBottom <= entryEMA[1] and bodyTop >= entryEMA[1]
emaCrossUp = ta.crossover(fastEMA, entryEMA)
emaCrossDown = ta.crossunder(fastEMA, entryEMA)

bool trigger1Buy = (emaCuttingCandle or emaCrossUp) and high > high[1] and close > entryEMA
bool trigger1Sell = (emaCuttingCandle or emaCrossDown) and low < low[1] and close < entryEMA

// 2. Trend Continuation Pullback & Bounce
bool uptrend = close > entryEMA and exitRSI >= 50
bool downtrend = close < entryEMA and exitRSI <= 50
bool trigger2Buy = enableTrendContinuation and uptrend and (low[1] <= fastEMA or low[1] <= entryEMA) and close > fastEMA and high > high[1]
bool trigger2Sell = enableTrendContinuation and downtrend and (high[1] >= fastEMA or high[1] >= entryEMA) and close < fastEMA and low < low[1]

// 3. Micro 5-Bar Range Breakout
bool trigger3Buy = enableRangeBreakout and close > rangeHigh5 and exitRSI >= 52 and close > entryEMA
bool trigger3Sell = enableRangeBreakout and close < rangeLow5 and exitRSI <= 48 and close < entryEMA

// 4. RSI Extreme Reversal Snap
bool trigger4Buy = enableRSIReversal and exitRSI < 32 and close > open and high > high[1]
bool trigger4Sell = enableRSIReversal and exitRSI > 68 and close < open and low < low[1]

bool rawBuy = trigger1Buy or trigger2Buy or trigger3Buy or trigger4Buy
bool rawSell = trigger1Sell or trigger2Sell or trigger3Sell or trigger4Sell

// Smart Filters
if (rawBuy or rawSell) and not volConfirmed
    rawBuy := false
    rawSell := false

if (rawBuy or rawSell) and enableADXFilter and adxValue < minADX
    rawBuy := false
    rawSell := false

// ============================================================================
// POSITION STATE MACHINE & SCALP DEFENSE
// ============================================================================

var int positionState = 0
var float entryPrice = na
var float highestPrice = na
var float lowestPrice = na
var float activeStopLoss = na
var bool beLocked = false

bool exitLong = false
bool exitShort = false
bool newBuy = false
bool newSell = false

// ---------------- LONG MANAGEMENT ----------------
if positionState == 1
    highestPrice := na(highestPrice) ? high : math.max(highestPrice, high)

    bool emaWeak = close < entryEMA
    bool rsiWeak = exitRSI < 50
    bool macdWeak = macdLine < macdSignal
    bool structureWeak = close < low[1]

    int longScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)
    bool smartExit = enableSmartExit and emaWeak and (longScore >= exitConfirmations)
    bool oppositeExit = exitOnOpposite and rawSell

    float profitATR = (close - entryPrice) / exitATR
    
    // Fast Scalp Take Profit
    bool tpExit = takeProfitATR > 0 and profitATR >= takeProfitATR

    // Auto-Breakeven
    if enableBreakeven and profitATR >= breakevenATR
        float beLevel = entryPrice + feeBufferUSD
        if na(activeStopLoss) or activeStopLoss < beLevel
            activeStopLoss := beLevel
            beLocked := true

    // Dynamic Trailing Stop
    bool protectionActive = enableProtection and profitATR >= activationATR
    float candidateStop = math.max(entryPrice + (beLocked ? feeBufferUSD : 0), highestPrice - exitATR * trailATR)
    if protectionActive
        activeStopLoss := na(activeStopLoss) ? candidateStop : math.max(activeStopLoss, candidateStop)

    bool stopHit = not na(activeStopLoss) and close <= activeStopLoss
    bool emergencyHit = enableEmergency and profitATR <= -emergencyATR

    if smartExit or oppositeExit or stopHit or emergencyHit or tpExit
        exitLong := true

// ---------------- SHORT MANAGEMENT ----------------
if positionState == -1
    lowestPrice := na(lowestPrice) ? low : math.min(lowestPrice, low)

    bool emaWeak = close > entryEMA
    bool rsiWeak = exitRSI > 50
    bool macdWeak = macdLine > macdSignal
    bool structureWeak = close > high[1]

    int shortScore = (emaWeak ? 1 : 0) + (rsiWeak ? 1 : 0) + (macdWeak ? 1 : 0) + (structureWeak ? 1 : 0)
    bool smartExit = enableSmartExit and emaWeak and (shortScore >= exitConfirmations)
    bool oppositeExit = exitOnOpposite and rawBuy

    float profitATR = (entryPrice - close) / exitATR
    
    // Fast Scalp Take Profit
    bool tpExit = takeProfitATR > 0 and profitATR >= takeProfitATR

    // Auto-Breakeven
    if enableBreakeven and profitATR >= breakevenATR
        float beLevel = entryPrice - feeBufferUSD
        if na(activeStopLoss) or activeStopLoss > beLevel
            activeStopLoss := beLevel
            beLocked := true

    // Dynamic Trailing Stop
    bool protectionActive = enableProtection and profitATR >= activationATR
    float candidateStop = math.min(entryPrice - (beLocked ? feeBufferUSD : 0), lowestPrice + exitATR * trailATR)
    if protectionActive
        activeStopLoss := na(activeStopLoss) ? candidateStop : math.min(activeStopLoss, candidateStop)

    bool stopHit = not na(activeStopLoss) and close >= activeStopLoss
    bool emergencyHit = enableEmergency and profitATR <= -emergencyATR

    if smartExit or oppositeExit or stopHit or emergencyHit or tpExit
        exitShort := true

// ---------------- EXITS ----------------
bool exitedThisBar = false

if exitLong
    positionState := 0
    entryPrice := na
    highestPrice := na
    lowestPrice := na
    activeStopLoss := na
    beLocked := false
    exitedThisBar := true

if exitShort
    positionState := 0
    entryPrice := na
    highestPrice := na
    lowestPrice := na
    activeStopLoss := na
    beLocked := false
    exitedThisBar := true

// ---------------- NEW ENTRIES ----------------
if positionState == 0 and not exitedThisBar
    if rawBuy
        newBuy := true
        positionState := 1
        entryPrice := close
        highestPrice := high
        lowestPrice := na
        activeStopLoss := low[1]
        beLocked := false
    else if rawSell
        newSell := true
        positionState := -1
        entryPrice := close
        lowestPrice := low
        highestPrice := na
        activeStopLoss := high[1]
        beLocked := false

// ============================================================================
// VISUAL PLOTS ON CHART
// ============================================================================

plotshape(newBuy, title="BUY Entry", style=shape.labelup, location=location.belowbar, color=color.rgb(16, 185, 129), text="SCALP BUY", textcolor=color.white, size=size.normal)
plotshape(newSell, title="SELL Entry", style=shape.labeldown, location=location.abovebar, color=color.rgb(244, 63, 94), text="SCALP SELL", textcolor=color.white, size=size.normal)
plotshape(exitLong, title="EXIT LONG", style=shape.labeldown, location=location.abovebar, color=color.rgb(245, 158, 11), text="EXIT LONG", textcolor=color.white, size=size.small)
plotshape(exitShort, title="EXIT SHORT", style=shape.labelup, location=location.belowbar, color=color.rgb(245, 158, 11), text="EXIT SHORT", textcolor=color.white, size=size.small)

// Live Stop Loss / Trailing Line
plot(activeStopLoss, title="Active Stop-Loss / Trailing Level", color=color.rgb(239, 68, 68), linewidth=2, style=plot.style_linebr)

// Entry Price Reference Line
plot(positionState != 0 ? entryPrice : na, title="Entry Price", color=color.rgb(148, 163, 184), linewidth=1, style=plot.style_circles)

// ============================================================================
// HUD INFO TABLE (TOP RIGHT OF CHART)
// ============================================================================

var table hud = table.new(position.top_right, 2, 8, bgcolor=color.rgb(15, 23, 42, 20), border_color=color.rgb(255, 255, 255, 15), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Mode", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 0, "High-Frequency Scalper (60+)", text_color=color.rgb(245, 158, 11), text_size=size.small)

    table.cell(hud, 0, 1, "Position", text_color=color.rgb(148, 163, 184), text_size=size.small)
    string posStr = positionState == 1 ? "LONG 🟢" : (positionState == -1 ? "SHORT 🔴" : "FLAT ⚪")
    color posCol = positionState == 1 ? color.rgb(16, 185, 129) : (positionState == -1 ? color.rgb(244, 63, 94) : color.rgb(148, 163, 184))
    table.cell(hud, 1, 1, posStr, text_color=posCol, text_size=size.small)

    table.cell(hud, 0, 2, "Entry Price", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 2, not na(entryPrice) ? "$" + str.tostring(entryPrice, "#.##") : "--", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "Active Stop", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 3, not na(activeStopLoss) ? "$" + str.tostring(activeStopLoss, "#.##") : "--", text_color=color.rgb(244, 63, 94), text_size=size.small)

    table.cell(hud, 0, 4, "Breakeven", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 4, beLocked ? "LOCKED (+Fees)" : "Ready (+0.35 ATR)", text_color=beLocked ? color.rgb(16, 185, 129) : color.rgb(245, 158, 11), text_size=size.small)

    table.cell(hud, 0, 5, "9 / 21 EMA", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 5, "$" + str.tostring(fastEMA, "#.##") + " / $" + str.tostring(entryEMA, "#.##"), text_color=color.rgb(6, 182, 212), text_size=size.small)

    table.cell(hud, 0, 6, "14 RSI / ATR", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(exitRSI, "#.#") + " / $" + str.tostring(exitATR, "#.##"), text_color=color.white, text_size=size.small)

    string volStr = volConfirmed ? "VOL OK ✅" : "LOW VOL ❌"
    color volCol = volConfirmed ? color.rgb(16, 185, 129) : color.rgb(244, 63, 94)
    table.cell(hud, 0, 7, "Volume", text_color=color.rgb(148, 163, 184), text_size=size.small)
    table.cell(hud, 1, 7, volStr, text_color=volCol, text_size=size.small)

// ============================================================================
// WEBHOOK ALERTS (EXCHANGE SYNCHRONIZED)
// ============================================================================

buyAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"BUY","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(low[1]) + '}'
sellAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"SELL","symbol":"' + syminfo.ticker + '","size":' + str.tostring(orderSize) + ',"price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(high[1]) + '}'
exitLongAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_LONG","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'
exitShortAlertMsg = '{"passphrase":"' + webhookPassphrase + '","action":"EXIT_SHORT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}'

if newBuy
    alert(buyAlertMsg, alert.freq_once_per_bar)

if newSell
    alert(sellAlertMsg, alert.freq_once_per_bar)

if exitLong
    alert(exitLongAlertMsg, alert.freq_once_per_bar)

if exitShort
    alert(exitShortAlertMsg, alert.freq_once_per_bar)

alertcondition(newBuy, title="DeltaBot SCALP BUY Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"BUY","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(newSell, title="DeltaBot SCALP SELL Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"SELL","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitLong, title="DeltaBot EXIT LONG Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_LONG","symbol":"{{ticker}}","price":{{close}}}')
alertcondition(exitShort, title="DeltaBot EXIT SHORT Alert", message='{"passphrase":"YOUR_PASSPHRASE","action":"EXIT_SHORT","symbol":"{{ticker}}","price":{{close}}}')
